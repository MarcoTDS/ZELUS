# Copie para .env e preencha. NUNCA versione o .env com valores reais.

# Chave do JWT: gere com  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
ZELUS_SECRET_KEY=

# Banco PostgreSQL (sem esta linha, usa postgresql://postgres:root@localhost:5432/zelus)
ZELUS_DATABASE_URL=postgresql://zelus:SENHA_DO_BANCO@localhost:5432/zelus

# Endereço público do front, usado nos links dos e-mails (sem barra no final)
ZELUS_URL_FRONTEND=http://127.0.0.1:5501

# Origens extras liberadas no CORS, separadas por vírgula (opcional)
ZELUS_CORS_ORIGINS=

# ENVIO DE E-MAIL (SMTP). Sem ZELUS_SMTP_HOST, os e-mails só aparecem no terminal do uvicorn.
# Gmail: ative a verificação em duas etapas e gere uma "Senha de app" em https://myaccount.google.com/apppasswords
ZELUS_SMTP_HOST=smtp.gmail.com
ZELUS_SMTP_PORTA=587
ZELUS_SMTP_TLS=true
ZELUS_SMTP_USUARIO=
ZELUS_SMTP_SENHA=
ZELUS_SMTP_REMETENTE=
